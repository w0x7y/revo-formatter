let x = 0
const result = loop/l do
    if x < 10 do
        x = x + 1
    end else do
        break/l(x)
    end
end
print(result) # 10

# an unlabeled loop used as an expression is always :nil
let n = 0
const nothing = loop do
    if n < 3 do
        n = n + 1
    end else do
        break(:nil)
    end
end
print(nothing) # :nil

# skip odd numbers
let odds = 0
for i in 0..6 do
    if i % 2 == 0 continue
    odds = odds + i
end
print(odds) # 9 (1 + 3 + 5)
